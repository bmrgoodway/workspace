[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "upstream"]
	url = https://github.com/bmr-apps/workspace.git
	fetch = +refs/heads/main:refs/remotes/upstream/main
	pushurl = DISABLED-no-push
[branch "main"]
	remote = upstream
	merge = refs/heads/main
[remote "origin"]
	url = https://github.com/bmrgoodway/workspace.git
	fetch = +refs/heads/*:refs/remotes/origin/*
